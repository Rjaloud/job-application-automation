        "mode": "runOnceForEachItem",
        "jsCode": "const original = $(\"Loop Over Items\").item.json;\n\nreturn {\n  json: {\n    ...original,\n    data: $input.item.json.data\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
